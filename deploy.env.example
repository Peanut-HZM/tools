# 部署脚本配置文件
# 复制此文件为 deploy.env 并填入实际配置
# cp deploy.env.example deploy.env

# ========================================
# 服务器配置
# ========================================
# 服务器 IP 或域名
SERVER_HOST=
# SSH 用户名
SERVER_USER=root
# SSH 端口
SERVER_PORT=22

# ========================================
# 部署路径
# ========================================
# 前端静态文件部署目录
FRONTEND_DEPLOY_PATH=/data/www/tools
# 后端代码部署目录
BACKEND_DEPLOY_PATH=/data/programs/tools

# ========================================
# 域名配置
# ========================================
# 项目域名（用于前端构建和部署验证）
DOMAIN=

# ========================================
# 后端服务配置
# ========================================
# systemd 服务名
BACKEND_SERVICE=tools-backend.service
# 后端监听端口
BACKEND_PORT=19092

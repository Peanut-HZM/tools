# ========================================
# 开发环境配置
# ========================================
# 使用 npm run dev 时自动加载（覆盖 .env）

# API 代理目标地址（Vite dev server 会代理到此地址）
VITE_API_PROXY_TARGET=http://127.0.0.1:19092

# 前端标题（开发环境）
VITE_APP_TITLE=工具箱开发

# ========================================
# 生产环境配置
# ========================================
# 使用 npm run build 时自动加载（覆盖 .env）
# 注意：部署时也可通过 VITE_API_BASE_URL 环境变量覆盖

# API 地址（生产环境使用绝对地址，按实际域名修改）
# VITE_API_BASE_URL=https://your-domain.com/api

# 前端标题（生产环境）
# VITE_APP_TITLE=工具箱

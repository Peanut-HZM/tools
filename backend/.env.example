# ========================================
# 应用基础配置
# ========================================
APP_NAME=Tool Aggregation API
ENV=dev
DEBUG=true
BACKEND_PORT=19092

# 数据库 URL（默认 SQLite，生产环境建议 PostgreSQL）
# SQLite 示例: sqlite:///./data/tools.db
# PostgreSQL 示例: postgresql://user:password@localhost:5432/tools_db
DATABASE_URL=sqlite:///./data/tools.db

# ========================================
# 安全密钥（生产环境必须修改！）
# ========================================
# 生成方法: python scripts/generate_keys.py
JWT_SECRET_KEY=dev-jwt-secret-change-me
DB_ENCRYPTION_KEY=dev-db-encryption-change-me

# JWT 过期时间（分钟，默认 7 天）
JWT_EXPIRE_MINUTES=10080

# ========================================
# CORS 配置
# ========================================
# 允许的源，逗号分隔
# 生产环境追加你的域名，如: http://localhost:5178,https://your-domain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5179,http://localhost:5180,http://localhost:5181,http://localhost:5182,http://localhost:5183,http://localhost:5184,http://localhost:5185,http://localhost:5186,http://localhost:5187,http://localhost:5188,http://localhost:5189,http://localhost:5190,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,http://127.0.0.1:5177,http://127.0.0.1:5178,http://127.0.0.1:5179,http://127.0.0.1:5180,http://127.0.0.1:5181,http://127.0.0.1:5182,http://127.0.0.1:5183,http://127.0.0.1:5184,http://127.0.0.1:5185,http://127.0.0.1:5186,http://127.0.0.1:5187,http://127.0.0.1:5188,http://127.0.0.1:5189,http://127.0.0.1:5190,http://localhost:3000

# ========================================
# 存储配置
# ========================================
# 存储提供者: aliyun_oss | minio
STORAGE_PROVIDER=minio

# Aliyun OSS（如使用 aliyun_oss 则必填）
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_CALLBACK_URL=

# MinIO（如使用 minio 则必填）
MINIO_ENDPOINT=
MINIO_API_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=tools-files
MINIO_SECURE=true

# ========================================
# 缓存配置（Redis）
# ========================================
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0
CACHE_REDIS_PASSWORD=
CACHE_REDIS_TOKEN_USAGE_TTL=3600

# ========================================
# OpenClaw 网关（可选）
# ========================================
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18081
OPENCLAW_TOKEN=

# ========================================
# OCR / ASR 服务（可选，如使用则必填）
# ========================================
# Umi-OCR 服务地址
OCR_API_URL=
OCR_API_KEY=
OCR_API_SECRET=

# ASR 服务地址
ASR_API_URL=
ASR_API_KEY=

# ========================================
# 数据库连接池（可选，SQLite 无需修改）
# ========================================
# DB_PSYCOPG_POOL_MIN_CONN=5
# DB_PSYCOPG_POOL_MAX_CONN=50
# DB_SQLALCHEMY_POOL_SIZE=10
# DB_SQLALCHEMY_MAX_OVERFLOW=10
# DB_SQLALCHEMY_POOL_TIMEOUT=10

# ========================================
# Harness Checkpoint time-travel (Phase 3-Plan-1D)
# ========================================
# Planned toggles — not yet enforced in P1D; included here for documentation / future rollout.
# HARNESS_CHECKPOINT_ENABLED=1             # Global toggle (planned — not yet enforced)
# HARNESS_CHECKPOINT_MAX_PER_BRANCH=500   # Per-branch cap (planned — not yet enforced)

# ========================================
# 用户数据路径（可选）
# ========================================
# USERS_DATA_PATH=./data/users

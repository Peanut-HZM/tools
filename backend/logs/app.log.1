[SQL: CREATE TABLE `ehr_portal_dev`.`portal_team_dashboard_grant` (
  `id` BIGINT NOT NULL COMMENT '主键ID（雪花ID）',
  `dashboard_code` VARCHAR(64) NOT NULL COMMENT '关联看板模板编码（逻辑外键，对应 portal_team_dashboard_def.dashboard_code）',
  `grant_type` VARCHAR(20) NOT NULL COMMENT '授权维度：ROLE-角色，DEPT-部门，USER-用户，ALL-全员',
  `grant_id` VARCHAR(64) NOT NULL COMMENT '授权主体ID：与 grant_type 对应的 角色ID/部门ID/用户ID；ALL 时填 *',
  `data_source_codes_json` TEXT DEFAULT NULL COMMENT '允许的 dataSourceCode 列表（JSON 数组）；NULL、空串或 [] 表示无任何允许编码（须显式列出；不回落模板默认全集）',
  `status` VARCHAR(20) NOT NULL DEFAULT 'ENABLED' COMMENT '状态：ENABLED-启用，DISABLED-停用',
  `create_by` VARCHAR(64) DEFAULT NULL COMMENT '创建者',
  `create_time` DATETIME DEFAULT NULL COMMENT '创建时间',
  `update_by` VARCHAR(64) DEFAULT NULL COMMENT '更新者',
  `update_time` DATETIME DEFAULT NULL COMMENT '更新时间',
  `deleted` TINYINT(1) NOT NULL DEFAULT 0 COMMENT '逻辑删除：0-否，1-是',
  `remark` VARCHAR(500) DEFAULT NULL COMMENT '备注',
  PRIMARY KEY (`id`),
  UNIQUE KEY `ux_dashboard_grant` (`dashboard_code`, `grant_type`, `grant_id`) USING BTREE,
  KEY `idx_grant_type_id` (`grant_type`, `grant_id`) USING BTREE,
  KEY `idx_status` (`status`) USING BTREE,
  KEY `idx_update_time` (`update_time`) USING BTREE
) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4 COMMENT = 'HR门户-团队管理看板授权表（按 dashboard_code+grant_type+grant_id 唯一；]

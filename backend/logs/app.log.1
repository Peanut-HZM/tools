[SQL: -- 曾创建 skill_audit_runtime_config 的环境：将 id=1 的开关合并到 skill_audit_prompt sentinel 行后删除旧表。
-- 仅执行一次；若无旧表请勿执行（会报错）。
UPDATE `skill_audit_prompt` p
INNER JOIN `skill_audit_runtime_config` r ON r.id = 1
SET
  p.`sync_llm_enabled` = IFNULL(r.`sync_llm_enabled`, 0),
  p.`async_llm_enabled` = IFNULL(r.`async_llm_enabled`, 0)
WHERE p.`prompt_scene` = 'AUDIT_RUNTIME_CONFIG'

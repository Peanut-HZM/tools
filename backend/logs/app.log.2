[SQL: -- 3. 删除「非 id」列上的主键（可重复执行；已迁到 id 时本段无操作）
DO $$
DECLARE
    pk_name text;
BEGIN
    FOR pk_name IN
        SELECT con.conname
        FROM pg_constraint con
                 JOIN pg_class rel ON rel.oid = con.conrelid
                 JOIN pg_namespace nsp ON nsp.oid = rel.relnamespace
        WHERE nsp.nspname = 'hr'
          AND rel.relname = 'iap_glodon_user'
          AND con.contype = 'p'
          AND NOT EXISTS (
            SELECT 1
            FROM unnest(con.conkey) AS col(attnum)
                     JOIN pg_attribute a
                          ON a.attrelid = con.conrelid
                              AND a.attnum = col.attnum
            WHERE a.attname = 'id'
        )
    LOOP
        EXECUTE format('ALTER TABLE hr.iap_glodon_user DROP CONSTRAINT %%%%I', pk_name);
        RAISE NOTICE '已删除旧主键约束: %%%%', pk_name;
    END LOOP;
END $$;]
